NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://kafaat:kafaat@localhost:5432/kafaat
SESSION_HASH_PEPPER=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=43200
SESSION_IDLE_TIMEOUT_SECONDS=3600
MFA_ENCRYPTION_KEY=replace-with-a-separate-random-32-character-secret
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
DB_LOGGING=false
ENABLE_SWAGGER=true
METRICS_TOKEN=replace-with-at-least-32-random-characters

# Bunny Stream secrets belong on the backend only. Never prefix them with NEXT_PUBLIC_.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READ_ONLY_API_KEY=
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_STREAM_REQUEST_TIMEOUT_MS=10000
BUNNY_STREAM_UPLOAD_TOKEN_TTL_SECONDS=7200
BUNNY_STREAM_PLAYBACK_TOKEN_TTL_SECONDS=300

# Jitsi Meet self-hosted integration. All values stay on the backend only.
# JITSI_MEET_URL must use the final HTTPS meeting subdomain, e.g. https://meet.example.com
JITSI_MEET_URL=
JITSI_DOMAIN=
JITSI_APP_ID=kafaat
JITSI_APP_SECRET=
JITSI_JOIN_TOKEN_TTL_SECONDS=7200

# Optional: creates the first super-admin only when running `npm run db:seed`.
SEED_ADMIN_NAME=مدير المنصة
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=+966500000000
SEED_ADMIN_PASSWORD=
