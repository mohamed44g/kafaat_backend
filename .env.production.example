# Copy to .env.production on the VPS and replace every placeholder.
POSTGRES_DB=kafaat
POSTGRES_USER=kafaat
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
DATABASE_URL=postgresql://kafaat:replace-with-the-same-postgres-password@127.0.0.1:5432/kafaat

NODE_ENV=production
PORT=3001
SESSION_HASH_PEPPER=replace-with-a-long-random-session-pepper
SESSION_TTL_SECONDS=43200
SESSION_IDLE_TIMEOUT_SECONDS=3600
MFA_ENCRYPTION_KEY=replace-with-a-separate-long-random-mfa-key
CORS_ORIGINS=https://kafaat-academy.com
LOG_LEVEL=info
DB_LOGGING=false
ENABLE_SWAGGER=false
METRICS_TOKEN=replace-with-a-long-random-metrics-token

BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READ_ONLY_API_KEY=
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_STREAM_REQUEST_TIMEOUT_MS=10000
BUNNY_STREAM_UPLOAD_TOKEN_TTL_SECONDS=7200
BUNNY_STREAM_PLAYBACK_TOKEN_TTL_SECONDS=300

JITSI_MEET_URL=https://meet.example.com
JITSI_DOMAIN=meet.example.com
JITSI_APP_ID=kafaat
JITSI_APP_SECRET=replace-with-a-long-random-jitsi-secret
JITSI_JOIN_TOKEN_TTL_SECONDS=7200
